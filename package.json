{
  "name": "qiyas",
  "private": true,
  "version": "0.0.2",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:fast": "tauri dev --config crates/qiyas-desktop/tauri.conf.json --config crates/qiyas-desktop/tauri.fast.conf.json",
    "bundle": "scripts/build-sidecar.sh && tauri build --config crates/qiyas-desktop/tauri.bundle.conf.json",
    "bundle:signed": "scripts/build-sidecar.sh && tauri build --config crates/qiyas-desktop/tauri.bundle.conf.json --config crates/qiyas-desktop/tauri.updater.conf.json"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@headless-tree/core": "1.8.0",
    "@headless-tree/react": "1.8.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.22",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "cmdk": "1.1.1",
    "papaparse": "5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
