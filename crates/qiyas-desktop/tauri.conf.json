{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qiyas",
  "version": "0.0.2",
  "identifier": "com.qsmind.qiyas",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qiyas",
        "width": 1440,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["dwg"],
        "name": "Qiyas drawing (DWG)",
        "description": "Qiyas drawing (DWG)",
        "mimeType": "image/vnd.dwg",
        "rank": "Alternate"
      },
      {
        "ext": ["dxf"],
        "name": "Qiyas drawing (DXF)",
        "description": "Qiyas drawing (DXF)",
        "mimeType": "image/vnd.dxf",
        "rank": "Alternate"
      },
      {
        "ext": ["qiyas"],
        "name": "Qiyas project",
        "description": "Qiyas project",
        "mimeType": "application/x-qiyas",
        "rank": "Owner",
        "contentTypes": ["com.qsmind.qiyas.project"],
        "exportedType": {
          "identifier": "com.qsmind.qiyas.project",
          "conformsTo": ["public.json"]
        }
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/qiyas.desktop",
        "files": {
          "/usr/share/mime/packages/com.qsmind.qiyas.xml": "linux/com.qsmind.qiyas.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/qiyas.desktop",
        "files": {
          "/usr/share/mime/packages/com.qsmind.qiyas.xml": "linux/com.qsmind.qiyas.xml"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBMERGNTY1MjlCRThGOEQKUldTTmo3NHBaZlVOT2wvMkl2ZmsvOWNhL3V6ZHBFblpkdFlSRWUySW4za0F3dm5RclpDN24vUlMK",
      "endpoints": ["https://github.com/qs-mind/qiyas/releases/latest/download/latest.json"]
    }
  }
}
