{
  "opening": {
    "at": [0, 0],
    "filter": {"category": "opening"},
    "columns": ["mark", "kind", "size", "count"],
    "headers": ["Mark", "Kind", "Width x height (mm)", "Count"],
    "group_by": ["mark"],
    "templates": {
      "mark": "{if(kind == 'door', 'D', if(kind == 'window', 'W', kind))}-{width * 1000:6t}x{(head-sill) * 1000:6t}",
      "kind": "{if(kind == 'door', 'Door', if(kind == 'window', 'Window', kind))}",
      "size": "{width * 1000:6t} x {(head-sill) * 1000:6t}"
    },
    "decimals": {"count": 0},
    "totals": {"mark": "Total", "count": ""},
    "total_by": ["kind"],
    "ar_headers": ["العلامة", "النوع", "العرض × الارتفاع (مم)", "العدد"],
    "ar_templates": {
      "kind": "{if(kind == 'door', 'باب', if(kind == 'window', 'شباك', kind))}",
      "size": "{width * 1000:6t} × {(head-sill) * 1000:6t}"
    },
    "ar_totals": {"mark": "الإجمالي", "count": ""},
    "ar_total_labels": {"باب": "إجمالي الأبواب", "شباك": "إجمالي الشبابيك"},
    "default_layer": "A-ANNO-TABL"
  },
  "room": {
    "at": [0, 0],
    "filter": {"category": "room"},
    "columns": ["name", "net_floor_area"],
    "headers": ["Room", "Area (m²)"],
    "templates": {"name": "{if(name == '', 'Room ', '')}{if(name == '', id, name)}"},
    "decimals": {"net_floor_area": 2},
    "totals": {"name": "Total area", "net_floor_area": ""},
    "default_layer": "A-ANNO-TABL",
    "preserve_overrides": true
  }
}
